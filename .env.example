# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Sirve la clave "anon" o la "publishable". Nunca pongas aquí la "service_role".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/vint4ge_fl0w
# Dirección pública de la web (para los enlaces de los correos de confirmación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
